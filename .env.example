# 2026-11-03: names only. Copy to .env.local for local dev. Set the same VITE_* names on the host that builds the site.
# Vite bakes any VITE_ value into the browser bundle at build time. Do not put secrets here.

# Public site origin. Used later for canonical links and Open Graph.
VITE_SITE_URL=https://galactos.io

# Form Worker URL. The page does not call this until MAX-1027.
VITE_FORM_ENDPOINT=https://galactos-form.<account>.workers.dev

# Unused. Plausible is the script tag in index.html, not a key.
VITE_ANALYTICS_KEY=

# Playwright screenshot harness (MAX-996). Local only.
PLAYWRIGHT_BASE_URL=http://localhost:8443

# References file. Not a token. Landing-page Dev Mode file is separate.
FIGMA_FILE_KEY=V2K9MFBI5DHBZPlnK0wag3
